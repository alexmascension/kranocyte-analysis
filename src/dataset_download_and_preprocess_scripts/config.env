# Copy this file to config.env and set DATA_ROOT to an absolute path with
# ample free space. You can also export these variables before running a script.

DATA_ROOT="/scratch/alexmascension/kranocito/data/public_scRNAseq"

# Computational settings
THREADS=16
STAR_IMAGE="gcfntnu/star:2.7.11b"

# The longest cDNA reads in these datasets are approximately 150 nt.
# STAR recommends read length - 1 when building the splice-junction database.
SJDB_OVERHANG=149

# Network retry settings used by curl.
CURL_RETRIES=8


CONTAINER_ENGINE="apptainer"
