# --- data, results and figures: entirely outside git ------------------------
data/
results/
figures/
deposits/

# ...except the READMEs that explain how to rebuild each level
!data/README.md
!results/README.md
!figures/README.md

# --- notebooks: the source yes, the outputs no ------------------------------
# The .ipynb files are versioned with the outputs stripped (CODE-NB-004, nbstripout).
notebooks/rendered/

# --- local configuration ----------------------------------------------------
config/config.env
env_snapshot_*/

# --- migration --------------------------------------------------------------
_TO_DELETE/
_ARCHIVE/
migration_*.log
undo_*.sh

# --- tool noise -------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.cache/
.pybiomart.sqlite
.DS_Store
*/**.gz
*.html
.vscode/
src/src_forgotten_nbs

# ---------------------------------------------------------------------------
# What IS versioned even though it looks like data (the CODE-PROV-002 exception:
# small derived tables, regenerated by a script, never edited by hand):
#
#   config/samples/*.tsv        what each GSM is and which condition it belongs to
#   workflow/containers.tsv     image, sha256 of the .sif and provenance
#   deposits/*/MANIFEST.tsv     manifest of each bundle  (see the exception below)
# ---------------------------------------------------------------------------
!deposits/
deposits/*
!deposits/*/
deposits/*/*
!deposits/*/MANIFEST.tsv